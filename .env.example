# Copie para .env (ignorado pelo git) e troque os valores. Nunca commite o .env real.

# Senha do SQL Server (min. 8 caracteres com maiuscula, minuscula, numero e simbolo)
MSSQL_SA_PASSWORD=Placeholder_ChangeMe123!

# Chave de assinatura dos tokens JWT (min. 32 caracteres, aleatoria). Gere com: openssl rand -base64 64
JWT_KEY=GereUmaChaveAleatoriaDePeloMenos32BytesAqui
