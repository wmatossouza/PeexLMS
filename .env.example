# Opcional: o projeto funciona sem este arquivo (ver README). Copie para .env para personalizar.

# Senha do SQL Server (min. 8 caracteres com maiuscula, minuscula, numero e simbolo)
MSSQL_SA_PASSWORD=Placeholder_ChangeMe123!

# Chave dos tokens JWT (min. 32 caracteres). Vazio = chave aleatoria a cada subida. Gere com: openssl rand -base64 64
JWT_KEY=
